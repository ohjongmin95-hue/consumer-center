# 소비자제보센터 설정 예시. 실제 값은 서버의 /etc/soboru.env 에 둡니다 (deploy/setup.sh가 자동 생성).
# 이 파일에는 진짜 비밀번호·비밀키를 적지 마세요. 값 뒤에 같은 줄로 주석(#)을 달지 마세요.

# 로그인 쿠키 서명용 비밀키. 만들기: openssl rand -hex 32
SECRET_KEY=
# 관리자 비밀번호의 해시값(비밀번호 원문 아님). 만들기:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('새 관리자 비밀번호'))"
ADMIN_PASSWORD_HASH=

# 데이터 위치 (DB 파일과 첨부파일 폴더)
DATABASE_PATH=/var/lib/soboru/cases.sqlite3
UPLOAD_DIR=/var/lib/soboru/uploads

# nginx 뒤에서 돌 때 1 (접속 IP·https 주소를 올바르게 인식)
TRUST_PROXY=1
# HTTPS 인증서를 붙인 뒤 1 (로그인 쿠키를 https에서만 보냄)
HTTPS_ONLY=1

# 기능 켜기(1) / 끄기(0). 바꾼 뒤: sudo systemctl restart soboru
# 제보 접수
ENABLE_INTAKE=1
# 소비자게시판 글쓰기·공감·댓글
ENABLE_BOARD=1
# 회원가입·로그인은 SECRET_KEY가 있으면 자동으로 켜집니다.

# ---- 제보자 알림 (값을 넣으면 켜짐, 비우면 꺼짐). 자세한 준비 방법: docs/notifications.md ----
# 이메일 (SMTP). 지메일: smtp.gmail.com / 465, 네이버: smtp.naver.com / 465 (앱 비밀번호 사용)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# 보내는 사람 주소(비우면 SMTP_USER)와 이름
MAIL_FROM=
MAIL_FROM_NAME=소비자제보센터
# 카카오 알림톡 (솔라피). 콘솔에서 API 키 발급, 카카오 채널 연동 후 pfId 확인
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PFID=
# 솔라피에 등록한 발신번호 (선택)
SOLAPI_SENDER=
# 카카오 심사를 통과한 템플릿 ID. 비워 둔 알림은 카카오톡으로 안 보냄
KAKAO_TPL_RECEIVED=
KAKAO_TPL_STATUS=
KAKAO_TPL_MESSAGE=
KAKAO_TPL_COMPANY=
