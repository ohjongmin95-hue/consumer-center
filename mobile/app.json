{
  "expo": {
    "name": "소보루 CS",
    "slug": "soboru-cs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kr.co.soboru.cs",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "민원에 첨부할 사진을 고르려고 사진 보관함에 접근해요.",
        "NSCameraUsageDescription": "민원에 첨부할 사진을 찍으려고 카메라를 써요."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF4E0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "kr.co.soboru.cs"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#F89B00"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "민원에 첨부할 사진을 고르려고 사진 보관함에 접근해요.",
          "cameraPermission": "민원에 첨부할 사진을 찍으려고 카메라를 써요."
        }
      ]
    ],
    "scheme": "soborucs",
    "extra": {
      "apiBase": "https://cs.soboru.co.kr"
    }
  }
}
