# 소비자를위한신문 아침 데스크: 경제·소비자 이슈 10개 + 기사 초안 4편을 메일로 (soboru-newsdesk.timer가 아침 6시 30분에 부름)
# 켜기·끄기: sudo bash /opt/soboru/app/deploy/set-newsdesk.sh [off]
[Unit]
Description=소비자를위한신문 아침 데스크 메일
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=soboru
Group=soboru
WorkingDirectory=/opt/soboru/app
EnvironmentFile=/etc/soboru.env
ExecStart=/opt/soboru/venv/bin/python -m news_desk
TimeoutStartSec=1800
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/soboru
